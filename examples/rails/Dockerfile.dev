# Rails Development Dockerfile with Superpilot Sidecar
FROM ruby:3.2

WORKDIR /app

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    nodejs \
    postgresql-client \
    yarn && \
    rm -rf /var/lib/apt/lists/*

# Copy Gemfile
COPY Gemfile* ./

# Install gems
RUN bundle install

# Copy application code
COPY . .

# Precompile assets (optional for dev)
# RUN bundle exec rails assets:precompile

# Expose application port
EXPOSE 8081

# Development mode with Rails server
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "8081"]
